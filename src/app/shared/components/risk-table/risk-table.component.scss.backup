// components/risk-table/risk-table.component.scss

.risk-table-container {
  overflow-x: auto;
  background: white;
  border-radius: 8px;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);

  .risk-table {
    width: 100%;
    min-width: 1200px;

    // Header styles
    .dimension-header-row {
      background: linear-gradient(135deg, #f5f5f5 0%, #e0e0e0 100%);
    }

    .column-header-row {
      background: #fafafa;
    }

    th {
      font-weight: 600;
      color: #333;
      padding: 12px 16px;
      font-size: 13px;
      border-bottom: 2px solid #e0e0e0;

      &.dimension-header {
        text-align: center;
        font-size: 12px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        border-left: 4px solid;
        background: linear-gradient(135deg, #fafafa 0%, #f5f5f5 100%);

        mat-icon {
          vertical-align: middle;
          margin-right: 6px;
          font-size: 18px;
          width: 18px;
          height: 18px;
        }
      }

      &.column-sticky {
        position: sticky;
        left: 0;
        z-index: 10;
        background: #fff;
        box-shadow: 2px 0 4px rgba(0, 0, 0, 0.05);
      }

      &.risk-column {
        text-align: center;
        min-width: 100px;
      }
    }

    td {
      padding: 12px 16px;
      border-bottom: 1px solid #f0f0f0;
      font-size: 14px;
      transition: all 0.2s ease;

      &.column-sticky {
        position: sticky;
        left: 0;
        z-index: 5;
        background: #fff;
        box-shadow: 2px 0 4px rgba(0, 0, 0, 0.05);
        font-weight: 600;
      }

      &.risk-cell {
        text-align: center;
        font-weight: 600;
        font-size: 12px;
        text-transform: uppercase;
      }

      .description-text {
        display: block;
        max-width: 300px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
      }

      .status-badge {
        display: inline-block;
        margin-left: 4px;
        padding: 2px 5px;
        background: #ff9800;
        color: white;
        border-radius: 3px;
        font-size: 10px;
        font-weight: 700;
        animation: pulse 2s infinite;
      }
    }

    .data-row {
      cursor: pointer;
      transition: all 0.2s ease;

      &:hover {
        background: #fafafa;

        td {
          background: #fafafa;
        }
      }

      &.row-selected {
        background: #e3f2fd;

        td {
          background: #e3f2fd;
        }
      }

      &.row-pending {
        // Indicador visual para items pendientes
      }
    }

    // Risk level colors
    .risk-empty {
      background-color: #f5f5f5;
      color: #999;
    }

    .risk-low {
      background-color: #c8e6c9;
      color: #2e7d32;
    }

    .risk-medium {
      background-color: #fff9c4;
      color: #f57f17;
    }

    .risk-high {
      background-color: #ffccbc;
      color: #d84315;
    }

    .risk-critical {
      background-color: #ffcdd2;
      color: #c62828;
      animation: pulseGlow 2s infinite;
    }
  }
}

// Animations
@keyframes pulse {
  0%, 100% {
    opacity: 1;
  }
  50% {
    opacity: 0.7;
  }
}

@keyframes pulseGlow {
  0%, 100% {
    box-shadow: inset 0 0 0 0 rgba(198, 40, 40, 0.4);
  }
  50% {
    box-shadow: inset 0 0 8px 2px rgba(198, 40, 40, 0.6);
  }
}

// Responsive
@media (max-width: 1024px) {
  .risk-table-container {
    .risk-table {
      min-width: 100%;
      font-size: 12px;

      th, td {
        padding: 8px 12px;
      }
    }
  }
}
